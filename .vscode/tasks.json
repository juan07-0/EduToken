{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "label": "npm: dev",
      "detail": "Starts Express server with Vite middleware on port 3000",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*EduToken LMS Server running.*",
          "endsPattern": "^.*EduToken LMS Server running.*"
        }
      }
    },
    {
      "type": "npm",
      "script": "build",
      "label": "npm: build",
      "detail": "Builds the production bundle into dist/",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "type": "npm",
      "script": "lint",
      "label": "npm: lint",
      "detail": "Runs TypeScript type checking",
      "problemMatcher": ["$tsc"]
    }
  ]
}
